      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Sparse cumulative workload-state verifier" style="text;html=1;fontStyle=1;fontSize=22;fontColor=#0f172a;align=center" vertex="1" parent="1"><mxGeometry x="360" y="17" width="680" height="34" as="geometry"/></mxCell>
        <mxCell id="ledger" value="&lt;b&gt;1. Arrival ledger&lt;/b&gt;&lt;br&gt;&lt;br&gt;job release r_j&lt;br&gt;deadline d_j&lt;br&gt;energy E_j&lt;br&gt;region / class / site&lt;br&gt;&lt;font color='#0f766e'&gt;x_jt=0 outside [r_j,d_j]&lt;/font&gt;&lt;br&gt;immutable positive-energy join" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=16;spacing=12" vertex="1" parent="1"><mxGeometry x="30" y="105" width="240" height="285" as="geometry"/></mxCell>
        <mxCell id="state" value="&lt;b&gt;2. Cumulative state&lt;/b&gt;&lt;br&gt;&lt;br&gt;y_t=y_{t−1}+x_t&lt;br&gt;y_t≤A_t&lt;br&gt;y_{d_j}−y_{r_j−1}=E_j&lt;br&gt;&lt;br&gt;release • conservation • deadline&lt;br&gt;capacity • cross-midnight state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=16;spacing=12" vertex="1" parent="1"><mxGeometry x="320" y="105" width="280" height="285" as="geometry"/></mxCell>
        <mxCell id="lp" value="&lt;b&gt;3. Global LP projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;min ||p(x)−p~||₁ + C(x)&lt;br&gt;HiGHS global optimum&lt;br&gt;validation selects risk reserve&lt;br&gt;convex hull keeps feasibility&lt;br&gt;&lt;br&gt;exact job-flow witness • measured replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=16;spacing=12" vertex="1" parent="1"><mxGeometry x="650" y="105" width="300" height="285" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;4. Credit and payment gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;p_safe ≤ p^(ℓ*)&lt;br&gt;pointwise false-credit envelope&lt;br&gt;V(p;ξ)=max dual affine(ξ)&lt;br&gt;q01/q10/q50/q90/q99: finite cap&lt;br&gt;q99: fixed/flexible activation endpoint&lt;br&gt;N–1 security + signed value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=16;spacing=12" vertex="1" parent="1"><mxGeometry x="1000" y="105" width="370" height="285" as="geometry"/></mxCell>
        <mxCell id="a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;endArrow=block;html=1" edge="1" parent="1" source="ledger" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;endArrow=block;html=1" edge="1" parent="1" source="state" target="lp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;endArrow=block;html=1" edge="1" parent="1" source="lp" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell>
